{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "9da4285931df424cb77895cd2decbf97",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "BossLanceGlow (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -500.0,
            "y": -50.0,
            "width": 200.0,
            "height": 120.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "9f15fd25363a4c28b9c6cd3b21fd5974"
        },
        {
            "m_Id": "fac636bb319b497cbf1a68d5a4245b16"
        },
        {
            "m_Id": "a3d69a25ec1f456a9348da826f360351"
        },
        {
            "m_Id": "bb9547a1e60549c3bf53fdb243ec0c8d"
        },
        {
            "m_Id": "156f3bc7feab43f89886b67d18abd51e"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "BossLanceGlow",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// The halo around the laser's core: a wider ribbon turned to face the\n// camera, additive, brightest on the centre line and gone at its edges, so\n// the beam has no hard outline anywhere. UV.y runs across, 0 to 1.\nfloat across = abs(UV.y * 2.0 - 1.0);\n\n// Alpha carries the falloff on its own: in additive mode HDRP multiplies\n// colour by opacity itself, so fading the colour here as well would square it.\nAlpha = pow(saturate(1.0 - across), 2.2);\nEmission = GlowColor * GlowIntensity;"
}

