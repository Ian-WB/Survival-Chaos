{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "deb1109833c8425eb6b878210921dfd8",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "PlayerRoundGlow (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -500.0,
            "y": -100.0,
            "width": 200.0,
            "height": 120.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "e428f54758984398916c7a46d9cfb3b5"
        },
        {
            "m_Id": "a92a32a0927f44af8d0cec585cab4c72"
        },
        {
            "m_Id": "ee83f56a9f51447c9718e1645db15412"
        },
        {
            "m_Id": "ae693affb6b347fc9ad15cfe2ffa44c1"
        },
        {
            "m_Id": "f6e73b03f2e9459185bfbd6e50f259c0"
        },
        {
            "m_Id": "ccbf680f64fd4563bad8485594329743"
        },
        {
            "m_Id": "bf7805bef8314928b1f124fa4648ae8b"
        },
        {
            "m_Id": "926e5d70f7fd456dbfb5d4602b0e09ae"
        },
        {
            "m_Id": "ad883090e2a64eeea39acb0e183efad1"
        },
        {
            "m_Id": "30594491de2141e1bcbab19015d3b8c7"
        },
        {
            "m_Id": "32051a42b8df44ca98463555f04ad7b1"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PlayerRoundGlow",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// U runs tip to tip along the needle, so a is 0 at its centre and 1 at either\n// tip. Folding it makes both ends identical, which is why one material serves\n// both directions of travel.\nfloat a = abs(UV.x * 2.0 - 1.0);\n\n// Hot mint centre where the surface faces the camera; green towards the\n// silhouette and the tips.\nfloat centre = 1.0 - smoothstep(0.20, 0.70, a);\nfloat facing = smoothstep(0.55, 0.95, saturate(dot(normalize(Normal), normalize(ViewDir))));\nfloat3 colour = lerp(BodyColor * BodyIntensity, CoreColor * CoreIntensity, centre * facing);\n\n// Tips cool to 35% brightness; the geometry tapers them to a point.\ncolour *= 1.0 - 0.65 * smoothstep(0.55, 1.00, a);\n\n// A faint pulse running outward to both tips. Never flashes off, never above peak.\nfloat pulse = (1.0 - PulseDepth) + PulseDepth * cos(6.283185 * (a - PulseSpeed * Time));\n\nEmission = colour * pulse;"
}

