{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "1ea97ed1d38c44f79ad00ca45fcfc7b3",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "PlayerRoundTrail (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -500.0,
            "y": -50.0,
            "width": 200.0,
            "height": 120.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "46ea7a49d1404753bd03abf7d02bb663"
        },
        {
            "m_Id": "40fd5213a3a2462caabc51c65867b023"
        },
        {
            "m_Id": "0bae59d36823432bb9b106e7af184505"
        },
        {
            "m_Id": "f40f668fcebf445094985f3dcff95632"
        },
        {
            "m_Id": "2558798db1414bcebb57b0372ccf83d6"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PlayerRoundTrail",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// A TrailRenderer in Stretch mode runs U from the head (0) to the tail (1) and\n// V across the ribbon. Opaque at the head, fading to nothing at the tail, with\n// soft edges so it reads as light rather than a strip of tape.\nfloat along = saturate(UV.x);\nfloat across = abs(UV.y * 2.0 - 1.0);\nfloat edge = 1.0 - smoothstep(0.35, 1.0, across);\n\n// Alpha carries the fade on its own: in additive mode HDRP multiplies colour by\n// opacity itself, so fading the colour here as well would square the fade.\nAlpha = pow(1.0 - along, 1.6) * edge;\nEmission = TrailColor * TrailIntensity;"
}

